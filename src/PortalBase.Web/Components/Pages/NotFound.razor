@page "/not-found"
@layout LayoutAutenticacao
@using Microsoft.AspNetCore.Diagnostics

@* Destino das páginas de status (UseStatusCodePagesWithReExecute) e das rotas inexistentes. A mensagem segue o código
   ORIGINAL da resposta: 429 (muitas tentativas — limite por endereço de rede), 400 (formulário vencido ou inválido),
   403 (sem permissão) ou, no resto, "página não encontrada". Nunca detalhes internos (regra 16). *@

<PageTitle>@_titulo · Portal Base</PageTitle>

<h1 class="auth__title">@_titulo</h1>
<p class="auth__subtitle" id="mensagem-status">@_mensagem</p>

<a class="btn btn-primary w-full jc-center mt-4" href="/">Voltar ao início</a>

@code {
    private string _titulo = "Página não encontrada";
    private string _mensagem = "O endereço que você abriu não existe (ou não está mais disponível). Confira o endereço ou volte ao início.";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        switch (HttpContext?.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalStatusCode)
        {
            case StatusCodes.Status429TooManyRequests:
                _titulo = "Muitas tentativas";
                _mensagem = "Foram feitas muitas tentativas em pouco tempo a partir desta rede. Aguarde alguns minutos (até 5) e tente de novo.";
                break;
            case StatusCodes.Status400BadRequest:
                _titulo = "Solicitação inválida";
                _mensagem = "O formulário expirou ou não pôde ser validado. Volte à página, recarregue-a e tente de novo.";
                break;
            case StatusCodes.Status403Forbidden:
                _titulo = "Sem permissão";
                _mensagem = "Seu perfil não tem permissão para abrir esta página. Se precisar do acesso, fale com o administrador.";
                break;
        }
    }
}

@page "/auditoria/eventos"
@rendermode InterativoSemPrerender
@using PortalBase.Application.Autorizacao
@inject IDadosAuditoria Dados
@inject IAutorizacaoVisual Visual

<PageTitle>Auditoria · Portal Base</PageTitle>

<Breadcrumbs Itens="_migalhas" />
<PageHeader Eyebrow="Auditoria" Titulo="Eventos de auditoria"
            Subtitulo="Trilha imutável de quem fez o quê, quando e em qual tenant. Consulta autorizada no servidor; nunca exibe segredos ou payloads proibidos." />

@if (!Visual.Pode(Permissoes.AuditoriaVisualizar))
{
    <div class="card">
        <EmptyState Emoji="&#128683;" Titulo="Sem permissão"
                    Mensagem="Seu perfil não tem a permissão auditoria.visualizar. A decisão de acesso é validada no servidor.">
            <Acao><a class="btn btn-primary" href="/">Voltar ao dashboard</a></Acao>
        </EmptyState>
    </div>
}
else
{
    @if (_resultado?.Estado == EstadoConsultaAuditoria.Demonstracao)
    {
        <div class="alert alert-warn mb-4" role="note">
            <span class="a-icon" aria-hidden="true">&#9888;&#65039;</span>
            <div><div class="a-title">Dados de demonstração</div>
            <div class="a-body">Registros simulados para ilustrar a tela. Com um contribuinte selecionado e banco disponível, esta tela consome o read-model real (<span class="mono">ConsultaAuditoriaAutorizada</span>).</div></div>
        </div>
    }

    <div class="dt-wrap mb-4">
        <div class="dt-toolbar wrap gap-2">
            <FiltroPeriodo Rotulo="Ocorrido em" Desde="_desde" DesdeChanged="v => _desde = v" Ate="_ate" AteChanged="v => _ate = v" />
            <div class="searchbox mnw-200">
                <span class="s-icon" aria-hidden="true">&#128269;</span>
                <input class="input" placeholder="Ação (código exato, ex.: EventConsolidated)" value="@_acao" @oninput="e => _acao = e.Value?.ToString() ?? string.Empty" aria-label="Ação" />
            </div>
            <input class="input mw-240" placeholder="Ator (nome, login, e-mail)" value="@_ator" @oninput="e => _ator = e.Value?.ToString() ?? string.Empty" aria-label="Ator" />
            <input class="input mw-170" placeholder="Recurso" value="@_recurso" @oninput="e => _recurso = e.Value?.ToString() ?? string.Empty" aria-label="Tipo de recurso" />
            <input class="input mono mw-150" placeholder="Correlation ID" value="@_corr" @oninput="e => _corr = e.Value?.ToString() ?? string.Empty" aria-label="Correlation ID" />
            <select class="select mw-150" value="@_resultadoFiltro" @onchange="e => _resultadoFiltro = e.Value?.ToString() ?? string.Empty" aria-label="Resultado">
                <option value="Todos">Todos os resultados</option>
                <option value="Permitido">Permitido</option>
                <option value="Negado">Negado</option>
            </select>
            <div class="spacer"></div>
            <button class="btn btn-ghost btn-sm" @onclick="Limpar">Limpar</button>
            <button class="btn btn-primary btn-sm" @onclick="Filtrar" disabled="@(!PeriodoUi.EhValido(_desde, _ate))">Filtrar</button>
        </div>

        <div class="tabs head-line">
            <button class="tab @(_aba == "tabela" ? "active" : null)" @onclick='() => _aba = "tabela"'>Tabela</button>
            <button class="tab @(_aba == "timeline" ? "active" : null)" @onclick='() => _aba = "timeline"'>Timeline</button>
        </div>

        @if (_carga.EmAndamento)
        {
            <div class="state"><span class="spin" aria-hidden="true"></span><p class="mt-3">Consultando a trilha…</p></div>
        }
        else if (_resultado is null || _resultado.Estado == EstadoConsultaAuditoria.SemTenant)
        {
            <EmptyState Emoji="&#128193;" Titulo="Selecione um contribuinte"
                        Mensagem="A auditoria é consultada no contexto de um contribuinte autorizado. Selecione um contribuinte para ver a trilha (ou ative Ui:DadosDemonstracao para um exemplo)." />
        }
        else if (_resultado.Estado == EstadoConsultaAuditoria.Erro)
        {
            <div class="state"><div class="st-emoji" aria-hidden="true">&#9888;&#65039;</div>
                <h3>Não foi possível consultar a auditoria</h3>
                <p>A consulta falhou ou o acesso não foi autorizado para o contribuinte atual. Nenhum detalhe interno é exibido.</p></div>
        }
        else if (_resultado.Itens.Count == 0)
        {
            <EmptyState Emoji="&#128269;" Titulo="Nenhum registro para o filtro"
                        Mensagem="Ajuste os filtros ou o período." />
        }
        else if (_aba == "tabela")
        {
            <div class="dt-scroll">
                <table class="dt">
                    <thead><tr>
                        <th class="w-150">Data (UTC)</th><th>Ator</th><th>Ação</th><th>Recurso</th>
                        <th>Resultado</th><th>Correlation</th><th>Competência</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in _resultado.Itens)
                        {
                            <tr>
                                <td class="text-sm mono">@r.OcorridoEmUtc.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                                <td title="@($"Identificador: {r.Ator}")"><div class="fw-700">@r.AtorExibido</div><div class="text-xs text-muted">@r.DescricaoAtor</div></td>
                                <td class="mono text-sm">@r.Acao</td>
                                <td class="text-sm">@(r.Recurso ?? "—")</td>
                                <td><StatusBadge Texto="@r.Resultado" Situacao="@(r.Permitido ? "ok" : "bad")" /></td>
                                <td class="mono text-xs text-muted">@(r.CorrelationId ?? "—")</td>
                                <td class="mono text-sm">@(r.Competencia ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginacao Pagina="_resultado.Pagina" TamanhoPagina="_resultado.TamanhoPagina" Total="_resultado.Total"
                       Rotulo="eventos" OnAnterior="Anterior" OnProxima="Proxima" />
        }
        else
        {
            <div class="card-pad"><div class="timeline">
                @foreach (var r in _resultado.Itens)
                {
                    <div class="tl-step @(r.Permitido ? "done" : "error")">
                        <div class="tl-marker" aria-hidden="true">@(r.Permitido ? "✓" : "✕")</div>
                        <div class="tl-body">
                            <div class="tl-title">@r.Acao <span class="text-xs text-muted">· @(r.Recurso ?? "—")</span></div>
                            <div class="tl-meta">@r.AtorExibido (@r.DescricaoAtor) · @r.OcorridoEmUtc.ToString("dd/MM HH:mm", CultureInfo.InvariantCulture) UTC@(r.Motivo is null ? "" : " · " + r.Motivo)</div>
                        </div>
                    </div>
                }
            </div></div>
        }
    </div>
}

@code {
    private static readonly IReadOnlyList<Migalha> _migalhas = [new Migalha("Auditoria"), new Migalha("Eventos")];

    private string _ator = string.Empty;
    private string _acao = string.Empty;
    private string _recurso = string.Empty;
    private string _corr = string.Empty;
    private string _resultadoFiltro = "Todos";
    private DateTimeOffset? _desde;
    private DateTimeOffset? _ate;
    private string _aba = "tabela";
    private int _pagina = 1;
    private readonly CargaCoalescente _carga = new();
    private ResultadoAuditoriaVm? _resultado;

    private int TotalPaginas => _resultado is null || _resultado.TamanhoPagina < 1
        ? 1
        : (int)Math.Max(1, Math.Ceiling(_resultado.Total / (double)_resultado.TamanhoPagina));

    protected override async Task OnInitializedAsync()
    {
        if (Visual.Pode(Permissoes.AuditoriaVisualizar))
        {
            await Carregar();
        }
    }

    private async Task Filtrar()
    {
        _pagina = 1;
        await Carregar();
    }

    private async Task Limpar()
    {
        _ator = _acao = _recurso = _corr = string.Empty;
        _resultadoFiltro = "Todos";
        _desde = _ate = null;
        _pagina = 1;
        await Carregar();
    }

    private async Task Anterior()
    {
        if (_pagina > 1)
        {
            _pagina--;
            await Carregar();
        }
    }

    private async Task Proxima()
    {
        if (_pagina < TotalPaginas)
        {
            _pagina++;
            await Carregar();
        }
    }

    // Uma carga por vez (o DbContext do circuito não aceita duas consultas simultâneas — UI-003) e nenhum pedido se
    // perde: filtro, página ou limpeza pedidos durante uma carga são feitos com os valores atuais antes de ela
    // terminar, e só o resultado mais recente é exibido.
    private Task Carregar()
    {
        // Prompt 81: Desde > Até NÃO consulta (o FiltroPeriodo exibe a mensagem; o servidor também rejeita).
        if (!PeriodoUi.EhValido(_desde, _ate))
        {
            return Task.CompletedTask;
        }

        return _carga.ExecutarAsync(
            () => Dados.ConsultarAsync(new FiltroAuditoriaVm
            {
                Desde = _desde,
                Ate = _ate,
                Ator = _ator,
                Acao = _acao,
                TipoRecurso = _recurso,
                CorrelationId = _corr,
                Resultado = _resultadoFiltro,
                Pagina = _pagina,
                TamanhoPagina = 25,
            }),
            resultado => _resultado = resultado);
    }
}

@page "/conta/cadastrar-mfa"
@layout LayoutEntrada
@rendermode InterativoSemPrerender
@using System.Security.Claims
@using PortalBase.Application.Abstracoes
@using PortalBase.Application.Autorizacao
@using PortalBase.Application.Excecoes
@using PortalBase.Application.Identidade
@using QRCoder
@inject GestaoMfa Mfa
@inject IRepositorioUsuario Usuarios
@inject IContextoSeguranca Seguranca
@inject NavigationManager Navegacao

@* Cadastro da verificação em duas etapas (MFA) pelo PRÓPRIO usuário: QR code (gerado no servidor, PNG em data: URI) ou a
   chave para digitar no aplicativo, confirmação com um código e os códigos de recuperação (mostrados UMA vez). O usuário
   é sempre o da sessão (servidor), nunca um parâmetro. Depois do cadastro, entra de novo (sessão nova com o MFA). *@

<PageTitle>Verificação em duas etapas · Portal Base</PageTitle>

<h1 class="auth__title">Verificação em duas etapas</h1>
<p class="auth__subtitle">Proteja o seu acesso com um código do celular, além da senha.</p>

@switch (_etapa)
{
    case Etapa.Carregando:
        <div class="state" role="status"><span class="spin" aria-hidden="true"></span><p class="mt-3">Carregando…</p></div>
        break;

    case Etapa.JaCadastrado:
        <div class="alert alert-ok mb-4" role="status">
            <span class="a-icon" aria-hidden="true">&#9989;</span>
            <div class="a-body">A verificação em duas etapas já está ativa na sua conta.</div>
        </div>
        <a class="btn btn-secondary w-full jc-center" href="/conta/minha-conta">Voltar para Minha conta</a>
        break;

    case Etapa.PrecisaVerificar:
        <div class="alert alert-warn mb-4" role="status" id="mfa-precisa-verificar">
            <span class="a-icon" aria-hidden="true">&#128272;</span>
            <div class="a-body">
                Para cadastrar em outro celular, confirme antes um código do aplicativo atual (ou um código de recuperação).
                O celular atual continua valendo até você confirmar o código do novo; se desistir no meio, nada muda.
            </div>
        </div>
        <a class="btn btn-primary w-full jc-center" href="/conta/verificar?returnUrl=%2Fconta%2Fcadastrar-mfa%3Frecadastrar%3D1">Confirmar o código atual</a>
        break;

    case Etapa.Inicio:
        @if (_obrigatorio)
        {
            <div class="alert alert-warn mb-4" role="status" id="mfa-obrigatorio">
                <span class="a-icon" aria-hidden="true">&#128272;</span>
                <div class="a-body">O administrador exige a verificação em duas etapas na sua conta. Cadastre-a para continuar.</div>
            </div>
        }
        <ol class="text-sm mb-4">
            <li>Instale no celular um aplicativo autenticador (Microsoft Authenticator, Google Authenticator ou similar).</li>
            <li>Clique em <strong>Gerar QR code</strong> e leia o código com o aplicativo.</li>
            <li>Digite o código de 6 dígitos que o aplicativo mostrar e clique em <strong>Confirmar</strong>.</li>
        </ol>
        <button class="btn btn-primary w-full" id="btn-gerar-qr" type="button" @onclick="Gerar" disabled="@_ocupado">
            @(_ocupado ? "Gerando…" : "Gerar QR code")
        </button>
        break;

    case Etapa.Qr:
        <p class="text-sm">Leia o QR code com o aplicativo autenticador:</p>
        <img class="qr-mfa" id="qr-mfa" src="@_qr" alt="QR code para cadastrar o Portal Base no aplicativo autenticador" />
        <p class="text-sm text-muted">Não consegue ler? No aplicativo, escolha digitar a chave e informe:</p>
        <p class="mono text-center fw-700 mb-4" id="chave-mfa">@_chave</p>
        <div class="field">
            <label for="codigo-mfa">Código de 6 dígitos</label>
            <input class="input mono" id="codigo-mfa" inputmode="numeric" autocomplete="one-time-code" maxlength="10"
                   @bind="_codigo" @bind:event="oninput" disabled="@_ocupado" />
        </div>
        @if (_erro is not null)
        {
            <div class="alert alert-bad mb-4" role="alert"><span class="a-icon" aria-hidden="true">&#9888;&#65039;</span><div class="a-body">@_erro</div></div>
        }
        <button class="btn btn-primary w-full" id="btn-confirmar-mfa" type="button" @onclick="Confirmar" disabled="@(_ocupado || string.IsNullOrWhiteSpace(_codigo))">
            @(_ocupado ? "Confirmando…" : "Confirmar")
        </button>
        break;

    case Etapa.Concluido:
        <div class="alert alert-ok mb-4" role="status" id="mfa-cadastrado">
            <span class="a-icon" aria-hidden="true">&#9989;</span>
            <div class="a-body">Verificação em duas etapas cadastrada.</div>
        </div>
        <p class="text-sm"><strong>Guarde agora estes códigos de recuperação</strong> (anote ou imprima). Cada um funciona <strong>uma única vez</strong>, no lugar do código do celular, se você perder o aparelho. Eles não serão mostrados de novo.</p>
        <ul class="codigos-recuperacao mb-4" id="codigos-recuperacao">
            @foreach (var codigo in _codigos)
            {
                <li>@codigo</li>
            }
        </ul>
        <form method="post" action="/conta/logout">
            <AntiforgeryToken />
            <input type="hidden" name="aviso" value="mfa-cadastrado" />
            <button class="btn btn-primary w-full" id="btn-concluir-mfa" type="submit">Guardei os códigos — entrar de novo</button>
        </form>
        break;
}

@if (_etapa is Etapa.Inicio or Etapa.Qr or Etapa.PrecisaVerificar)
{
    <hr class="mt-6 mb-6" />
    <form method="post" action="/conta/logout">
        <AntiforgeryToken />
        <button class="btn btn-ghost w-full" type="submit">Sair</button>
    </form>
}

@code {
    private enum Etapa { Carregando, Inicio, Qr, Concluido, JaCadastrado, PrecisaVerificar }

    private Etapa _etapa = Etapa.Carregando;
    private Guid _usuarioId;
    private bool _obrigatorio;
    private bool _ocupado;
    private string? _qr;
    private string? _chave;
    private string _codigo = string.Empty;
    private string? _erro;
    private IReadOnlyList<string> _codigos = [];

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacao { get; set; }
    [SupplyParameterFromQuery] public int? Recadastrar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var usuario = EstadoAutenticacao is null ? null : (await EstadoAutenticacao).User;
        if (usuario?.Identity?.IsAuthenticated != true || !Guid.TryParse(usuario.FindFirstValue(ClaimTypes.NameIdentifier), out _usuarioId))
        {
            Navegacao.NavigateTo("/conta/entrar", replace: true);
            return;
        }

        var cadastro = await Usuarios.ObterPorIdAsync(_usuarioId);
        if (cadastro is null)
        {
            Navegacao.NavigateTo("/conta/entrar", replace: true);
            return;
        }

        _obrigatorio = cadastro.MfaObrigatorio;
        if (cadastro.MfaHabilitado)
        {
            // Trocar de celular desfaz o cadastro atual: só com o segundo fator confirmado nesta sessão.
            _etapa = Recadastrar == 1 ? (Seguranca.MfaSatisfeito ? Etapa.Inicio : Etapa.PrecisaVerificar) : Etapa.JaCadastrado;
            return;
        }

        _etapa = Etapa.Inicio;
    }

    private async Task Gerar()
    {
        _ocupado = true;
        try
        {
            var segredo = await Mfa.IniciarAtivacaoAsync(_usuarioId);
            _qr = QrCodePng(segredo.UriProvisionamento);
            _chave = Agrupar(segredo.SegredoBase32);
            _erro = null;
            _etapa = Etapa.Qr;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task Confirmar()
    {
        _ocupado = true;
        try
        {
            var concluida = await Mfa.ConfirmarAtivacaoAsync(_usuarioId, _codigo.Replace(" ", string.Empty, StringComparison.Ordinal).Trim());
            _codigos = concluida.CodigosRecuperacao;
            _qr = _chave = null; // o segredo não fica mais na tela
            _etapa = Etapa.Concluido;
        }
        catch (MfaInvalidoException)
        {
            _erro = "Código inválido ou expirado. Confira se o horário do celular está certo e digite o código que aparece agora.";
        }
        finally
        {
            _codigo = string.Empty;
            _ocupado = false;
        }
    }

    // QR code gerado no servidor (sem script externo): PNG em data: URI (CSP img-src 'self' data:).
    private static string QrCodePng(string conteudo)
    {
        using var gerador = new QRCodeGenerator();
        using var dados = gerador.CreateQrCode(conteudo, QRCodeGenerator.ECCLevel.M);
        var png = new PngByteQRCode(dados).GetGraphic(6);
        return "data:image/png;base64," + Convert.ToBase64String(png);
    }

    private static string Agrupar(string chave)
        => string.Join(' ', Enumerable.Range(0, (chave.Length + 3) / 4).Select(i => chave.Substring(i * 4, Math.Min(4, chave.Length - (i * 4)))));
}

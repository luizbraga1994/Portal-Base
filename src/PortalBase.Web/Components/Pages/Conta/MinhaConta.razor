@page "/conta/minha-conta"
@layout LayoutEntrada
@using System.Security.Claims
@using PortalBase.Application.Autorizacao
@using PortalBase.Application.Identidade
@inject IRepositorioUsuario Usuarios
@inject NavigationManager Navegacao

<PageTitle>Minha conta · Portal Base</PageTitle>

<h1 class="auth__title">Minha conta</h1>
<p class="auth__subtitle">Seus dados de acesso e a troca da sua senha.</p>

@if (_senhaTemporaria)
{
    <div class="alert alert-warn mb-4" role="status" id="aviso-senha-temporaria">
        <span class="a-icon" aria-hidden="true">&#128273;</span>
        <div class="a-body">
            <strong>Sua senha é temporária.</strong> Ela foi enviada por e-mail; para continuar, crie a sua senha definitiva
            abaixo (em <strong>Senha atual</strong>, digite a senha temporária).
        </div>
    </div>
}

@if (_usuario is not null)
{
    <dl class="conta-dados">
        <dt>Nome</dt>
        <dd>@_usuario.Nome</dd>
        <dt>E-mail (usado para entrar)</dt>
        <dd>@_usuario.Email</dd>
        <dt>Verificação em duas etapas (MFA)</dt>
        <dd>
            @(_usuario.MfaHabilitado ? "Ativa" : "Não cadastrada")@(_usuario.MfaObrigatorio ? " · exigida pelo administrador" : string.Empty)
            @if (!_senhaTemporaria)
            {
                @if (_usuario.MfaHabilitado)
                {
                    <a class="ml-2" id="link-recadastrar-mfa" href="/conta/cadastrar-mfa?recadastrar=1">Cadastrar em outro celular</a>
                }
                else
                {
                    <a class="ml-2" id="link-ativar-mfa" href="/conta/cadastrar-mfa">Ativar agora</a>
                }
            }
        </dd>
    </dl>
}

<h2 class="h-95 mb-3" id="alterar-senha">Alterar senha</h2>

@if (Senha == "alterada")
{
    <div class="alert alert-ok mb-4" role="status">
        <span class="a-icon" aria-hidden="true">&#9989;</span>
        <div class="a-body">Senha alterada. As outras sessões abertas com a senha antiga são encerradas em até 1 minuto.</div>
    </div>
}
else if (!string.IsNullOrEmpty(Erro))
{
    <div class="alert alert-bad mb-4" role="alert">
        <span class="a-icon" aria-hidden="true">&#9888;&#65039;</span>
        <div class="a-body">@MensagemErro()</div>
    </div>
}

<form method="post" action="/conta/alterar-senha">
    <AntiforgeryToken />
    <div class="field">
        <label for="senhaAtual">Senha atual</label>
        <input class="input" id="senhaAtual" name="senhaAtual" type="password" autocomplete="current-password" maxlength="@PoliticaSenha.TamanhoMaximo" required />
    </div>
    <div class="field">
        <label for="novaSenha">Nova senha</label>
        <input class="input" id="novaSenha" name="novaSenha" type="password" autocomplete="new-password"
               minlength="@PoliticaSenha.TamanhoMinimo" maxlength="@PoliticaSenha.TamanhoMaximo" required />
    </div>
    <div class="field">
        <label for="confirmacao">Confirme a nova senha</label>
        <input class="input" id="confirmacao" name="confirmacao" type="password" autocomplete="new-password"
               minlength="@PoliticaSenha.TamanhoMinimo" maxlength="@PoliticaSenha.TamanhoMaximo" required />
    </div>
    <RegrasSenha />
    <button class="btn btn-primary w-full" type="submit">Alterar senha</button>
</form>

<hr class="mt-6 mb-6" />

<div class="row gap-2">
    @if (!_senhaTemporaria)
    {
        <a class="btn btn-secondary flex-1 jc-center" href="/">Voltar ao portal</a>
    }
    <form method="post" action="/conta/logout" class="flex-1">
        <AntiforgeryToken />
        <button class="btn btn-danger w-full" type="submit">Sair</button>
    </form>
</div>

@code {
    private PortalBase.Domain.Catalogo.Usuario? _usuario;
    private bool _senhaTemporaria;

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacao { get; set; }
    [SupplyParameterFromQuery] public string? Senha { get; set; }
    [SupplyParameterFromQuery] public string? Erro { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Sem sessão: vai ao login (a troca em si é decidida no servidor, no POST /conta/alterar-senha).
        var usuario = EstadoAutenticacao is null ? null : (await EstadoAutenticacao).User;
        if (usuario?.Identity?.IsAuthenticated != true || !Guid.TryParse(usuario.FindFirstValue(ClaimTypes.NameIdentifier), out var id))
        {
            Navegacao.NavigateTo("/conta/entrar?returnUrl=%2Fconta%2Fminha-conta", replace: true);
            return;
        }

        _usuario = await Usuarios.ObterPorIdAsync(id);
        _senhaTemporaria = usuario.HasClaim(PortalBase.Web.Seguranca.ClaimsPortalBase.Pendencia, PortalBase.Web.Seguranca.ClaimsPortalBase.PendenciaTrocaSenha);
    }

    private string MensagemErro() => Erro switch
    {
        "atual" => "A senha atual não confere. Atenção: tentativas erradas contam para o bloqueio temporário da conta.",
        "diferentes" => "A confirmação não é igual à nova senha.",
        "mesma" => "A nova senha precisa ser diferente da atual.",
        _ => "A nova senha não atende às regras abaixo.",
    };
}

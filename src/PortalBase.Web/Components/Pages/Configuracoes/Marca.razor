@page "/admin/marca"
@rendermode InterativoSemPrerender
@using PortalBase.Application.Autorizacao
@using PortalBase.Application.Marca
@using PortalBase.Application.Multitenancy
@using PortalBase.Domain.Marca
@inject IAutorizacaoPlataforma AutzPlataforma
@inject IServicoAutorizacao AutzTenant
@inject ITenantContext Tenant
@inject ServicoMarcaPlataforma MarcaPlataforma
@inject ServicoMarcaTenant MarcaTenant

<PageTitle>Marca / Logo · Portal Base</PageTitle>

<Breadcrumbs Itens="_migalhas" />
<PageHeader Eyebrow="Configurações" Titulo="Marca visual (logo)"
            Subtitulo="@($"Configure a logo exibida no portal. Formatos aceitos: PNG ou JPEG, até {MarcaVisual.TamanhoMaximoTexto}.")" />

@if (Ok is "global")
{
    <div class="alert alert-ok mb-4" role="status"><span class="a-icon" aria-hidden="true">&#9989;</span>
        <div class="a-body">Logo global do portal atualizada.</div></div>
}
else if (Ok is "contribuinte")
{
    <div class="alert alert-ok mb-4" role="status"><span class="a-icon" aria-hidden="true">&#9989;</span>
        <div class="a-body">Logo do contribuinte atualizada.</div></div>
}
@if (Erro > 0)
{
    <div class="alert alert-bad mb-4" role="alert"><span class="a-icon" aria-hidden="true">&#9888;&#65039;</span>
        <div class="a-body">@MensagemErro(Erro)</div></div>
}

@if (!_carregado)
{
    <div class="state" role="status"><span class="spin" aria-hidden="true"></span><p class="mt-3">Carregando…</p></div>
}
else
{
    <div class="grid grid-2">
        @if (_podeContribuinte)
        {
            <div class="card card-pad">
                <h3 class="mb-1">Logo do contribuinte</h3>
                <p class="text-muted text-sm mb-4">Exibida na barra superior quando este contribuinte é o contexto ativo.</p>
                <div class="marca-preview mb-4">
                    @if (_temLogoTenant)
                    {
                        <img src="@($"/branding/logo/contribuinte?v={_v}")" alt="Logo do contribuinte" />
                    }
                    else
                    {
                        <span class="text-faint text-sm">Nenhuma logo configurada (usa a global).</span>
                    }
                </div>
                <form method="post" action="/admin/marca/contribuinte" enctype="multipart/form-data">
                    <AntiforgeryToken />
                    <div class="field">
                        <label for="arqTenant">Arquivo (PNG ou JPEG, até @MarcaVisual.TamanhoMaximoTexto)</label>
                        <input class="input" id="arqTenant" name="arquivo" type="file" accept="image/png,image/jpeg" required />
                    </div>
                    <button class="btn btn-primary" type="submit">Salvar logo do contribuinte</button>
                </form>
            </div>
        }

        @if (_podePlataforma)
        {
            <div class="card card-pad">
                <h3 class="mb-1">Logo global do portal</h3>
                <p class="text-muted text-sm mb-4">Exibida na tela de login e como padrão para contribuintes sem logo própria.</p>
                <div class="marca-preview mb-4">
                    @if (_temLogoGlobal)
                    {
                        <img src="@($"/branding/logo?v={_v}")" alt="Logo global" />
                    }
                    else
                    {
                        <span class="text-faint text-sm">Nenhuma logo global configurada (usa a marca padrão).</span>
                    }
                </div>
                <form method="post" action="/admin/marca/plataforma" enctype="multipart/form-data">
                    <AntiforgeryToken />
                    <div class="field">
                        <label for="arqGlobal">Arquivo (PNG ou JPEG, até @MarcaVisual.TamanhoMaximoTexto)</label>
                        <input class="input" id="arqGlobal" name="arquivo" type="file" accept="image/png,image/jpeg" required />
                    </div>
                    <button class="btn btn-primary" type="submit">Salvar logo global</button>
                </form>
            </div>
        }
    </div>

    @if (!_podePlataforma && !_podeContribuinte)
    {
        <div class="card">
            <EmptyState Emoji="&#128683;" Titulo="Sem permissão"
                        Mensagem="Seu perfil não pode configurar a marca visual. Fale com o administrador." />
        </div>
    }
}

@code {
    private static readonly IReadOnlyList<Migalha> _migalhas = [new Migalha("Configurações"), new Migalha("Marca / Logo")];

    [SupplyParameterFromQuery] public string? Ok { get; set; }
    [SupplyParameterFromQuery] public int Erro { get; set; }

    private readonly string _v = Guid.NewGuid().ToString("N");
    private bool _carregado;
    private bool _podePlataforma;
    private bool _podeContribuinte;
    private bool _temLogoGlobal;
    private bool _temLogoTenant;

    protected override async Task OnInitializedAsync()
    {
        // Autorização fail-closed (qualquer falha → seção oculta). As leituras de preview são resilientes:
        // uma indisponibilidade de banco nunca quebra a tela de configuração.
        try
        {
            _podePlataforma = (await AutzPlataforma.AvaliarAsync(Permissoes.MarcaPlataformaAdministrar)).Permitido;
        }
        catch
        {
            _podePlataforma = false;
        }

        if (_podePlataforma)
        {
            try { _temLogoGlobal = await MarcaPlataforma.ObterResumoAsync() is not null; }
            catch { _temLogoGlobal = false; }
        }

        if (Tenant.EstaAutorizado && Tenant.TenantId is Guid tenantId)
        {
            try
            {
                _podeContribuinte = (await AutzTenant.AvaliarAsync(tenantId, Permissoes.AdminTenant)).Permitido;
            }
            catch
            {
                _podeContribuinte = false;
            }

            if (_podeContribuinte)
            {
                try { _temLogoTenant = await MarcaTenant.ObterResumoAsync() is not null; }
                catch { _temLogoTenant = false; }
            }
        }

        _carregado = true;
    }

    private static string MensagemErro(int erro) => erro switch
    {
        1 => "Selecione um arquivo de imagem.",
        2 => $"O arquivo excede o tamanho máximo ({MarcaVisual.TamanhoMaximoTexto}).",
        3 => "Formato não suportado. Envie um PNG ou JPEG válido.",
        5 => "Selecione um contribuinte antes de configurar a logo.",
        _ => "Não foi possível salvar a logo. Verifique suas permissões e tente novamente.",
    };
}

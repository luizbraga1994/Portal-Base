@page "/operacoes/workers"
@rendermode InterativoSemPrerender
@using PortalBase.Application.Autorizacao
@inject IDadosOperacoes Dados
@inject IAutorizacaoVisual Visual

<PageTitle>Workers · Portal Base</PageTitle>

<Breadcrumbs Itens="_migalhas" />
<PageHeader Eyebrow="Operações" Titulo="Workers"
            Subtitulo="Saúde de cada trabalhador do host Worker, gravada no catálogo a cada batida. Sem batida recente = estagnado; sem registro não é 'saudável' — é ausência de informação.">
    <Acoes><button class="btn btn-secondary btn-sm" @onclick="Carregar" disabled="@_carregando">Atualizar</button></Acoes>
</PageHeader>

@if (!Visual.Pode(Permissoes.SegurancaIncidentesGerir))
{
    <div class="card"><EmptyState Emoji="&#128683;" Titulo="Sem permissão"
        Mensagem="A visão operacional exige a permissão de plataforma (seguranca.incidentes.gerir).">
        <Acao><a class="btn btn-primary" href="/">Voltar ao dashboard</a></Acao></EmptyState></div>
}
else if (_carregando)
{
    <div class="state" role="status"><span class="spin" aria-hidden="true"></span><p class="mt-3">Consultando workers…</p></div>
}
else if (_estado != EstadoConsultaUi.Ok || _painel is null)
{
    <div class="card"><div class="state" role="alert"><div class="st-emoji">&#9888;&#65039;</div>
        <h3>Não foi possível carregar</h3><p>A consulta falhou ou não foi autorizada.</p></div></div>
}
else if (_painel.WorkersSemTelemetria)
{
    <div class="card card-pad">
        <div class="row gap-3 ai-start">
            <span class="fs-14" aria-hidden="true">&#9888;&#65039;</span>
            <div>
                <div class="fw-700">Nenhum worker registrou saúde ainda</div>
                <p class="text-sm text-muted mtx-04">
                    O host Worker grava a saúde dos trabalhadores no catálogo a cada batida. Sem nenhum registro, o
                    Worker não está rodando (ou não alcança o banco do catálogo). Ausência de informação não é
                    "saudável".
                </p>
            </div>
        </div>
    </div>
}
else
{
    <div class="dt-wrap">
        <div class="dt-scroll">
            <table class="dt">
                <thead><tr><th>Worker</th><th>Estado</th><th class="tnum">Processado</th><th class="tnum">Erros</th><th class="tnum">Reinícios</th><th>Iniciado</th><th>Última batida</th><th>Último sucesso</th><th>Último erro</th></tr></thead>
                <tbody>
                    @foreach (var w in _painel.Workers)
                    {
                        <tr>
                            <td class="fw-700">@w.Worker</td>
                            <td><StatusBadge Texto="@w.EstadoRotulo" Situacao="@w.EstadoBadge" /></td>
                            <td class="tnum">@w.TotalProcessado.ToString("N0", _cultura)</td>
                            <td class="tnum">@w.TotalErros.ToString("N0", _cultura)</td>
                            <td class="tnum">@w.Reinicios.ToString("N0", _cultura)</td>
                            <td class="text-sm mono">@Data(w.IniciadoEmUtc)</td>
                            <td class="text-sm mono">@Data(w.UltimaBatidaUtc)</td>
                            <td class="text-sm mono">@Data(w.UltimoSucessoUtc)</td>
                            <td class="text-sm">@(w.UltimoErroCodigo is { Length: > 0 } c ? c : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private static readonly IReadOnlyList<Migalha> _migalhas = [new Migalha("Operações", "/operacoes/saude"), new Migalha("Workers")];
    private static readonly CultureInfo _cultura = CultureInfo.GetCultureInfo("pt-BR");

    private bool _carregando = true;
    private EstadoConsultaUi _estado = EstadoConsultaUi.SemPermissao;
    private PainelOperacoesVm? _painel;

    private static string Data(DateTimeOffset? d) => d is { } v ? v.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture) : "—";

    protected override async Task OnInitializedAsync()
    {
        if (Visual.Pode(Permissoes.SegurancaIncidentesGerir)) { await Carregar(); }
        else { _carregando = false; }
    }

    private async Task Carregar()
    {
        _carregando = true;
        try
        {
            var (painel, estado) = await Dados.ObterPainelAsync();
            _painel = painel;
            _estado = estado;
        }
        finally { _carregando = false; }
    }
}

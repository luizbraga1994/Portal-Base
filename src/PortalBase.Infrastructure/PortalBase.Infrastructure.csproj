<Project Sdk="Microsoft.NET.Sdk">

  <!--
    INFRASTRUCTURE: implementações concretas das portas da Application
    (EF Core 10 + MySQL, relógio, auditoria inicial, health checks).
    Depende de Application, Domain e Shared. Nenhum host depende do inverso.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortalBase.Application\PortalBase.Application.csproj" />
    <ProjectReference Include="..\PortalBase.Domain\PortalBase.Domain.csproj" />
    <ProjectReference Include="..\PortalBase.Shared\PortalBase.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prova por teste (Prompt 50, §38): os testes de integração verificam que a montagem de argumentos
         do executor físico NUNCA coloca senha/usuário na linha de comando (só via arquivo de opções). -->
    <InternalsVisibleTo Include="PortalBase.Integration.Tests" />
  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <!-- EF Core explícito: o provedor MySQL pede EF >= 10.0.9; a versão do CPM (alinhada ao EF Core Design) vale para
         toda a solução, evitando duas versões do EF Core entre a Infrastructure e quem a consome (MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- Configuração do servidor próprio (%ProgramData%\PortalBase\*.json, Producao/ConfiguracaoServidor). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Redação de logs e gravação no Log de Aplicativo do Windows (Observabilidade/LogEventosWindows). -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

</Project>

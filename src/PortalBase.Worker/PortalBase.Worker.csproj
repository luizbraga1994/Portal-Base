<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    WORKER: HOST de processamento em segundo plano (Generic Host). Sem regra de
    negócio própria: heartbeat e backup agendado. Acrescente os trabalhadores do seu domínio.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>portalbase-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortalBase.Application\PortalBase.Application.csproj" />
    <ProjectReference Include="..\PortalBase.Infrastructure\PortalBase.Infrastructure.csproj" />
    <ProjectReference Include="..\PortalBase.Shared\PortalBase.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>

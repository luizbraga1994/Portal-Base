<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FERRAMENTA DE DESENVOLVIMENTO: cria o primeiro acesso LOCAL (contribuinte provisionado + usuário com senha e
    MFA + vínculo/papéis), reutilizando os serviços reais (repositórios, provisionamento, hasher, GestaoMfa,
    auditoria). Recusa qualquer ambiente que não seja Development. NÃO é publicada nas imagens (os Dockerfiles
    publicam apenas Web/Worker) e não é referenciada por código de produção.
    Uso: scripts/criar-acesso-local.ps1 (detalhes em docs/AMBIENTE-LOCAL.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PortalBase.Application\PortalBase.Application.csproj" />
    <ProjectReference Include="..\..\src\PortalBase.Infrastructure\PortalBase.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuração user-secrets + JSON + variáveis de ambiente (sem host). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- MESMA configuração-base (não secreta) da Web: chaves e refs idênticas; os segredos vêm dos user-secrets da Web. -->
    <Content Include="..\..\src\PortalBase.Web\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\PortalBase.Web\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

# ============================================================================
# Portal Base — TEMPLATE de variáveis de ambiente para DESENVOLVIMENTO LOCAL.
# Copie para `.env` (ignorado pelo git) e PREENCHA os valores vazios.
#
#   cp .env.example .env
#
# ATENÇÃO (regra 7): este arquivo é só um MODELO — NUNCA versione segredos.
# Estes valores NÃO SÃO PARA PRODUÇÃO; em produção os segredos vêm do COFRE
# (Vault:Modo=KeyVault + Vault:Endpoint; o startup aborta sem eles).
# ============================================================================

# ----------------------------------------------------------------------------
# (A) DOCKER COMPOSE  —  `docker compose up`  LÊ estas variáveis diretamente.
# ----------------------------------------------------------------------------
# Senha do MySQL local (defina um valor forte só para o seu ambiente).
MYSQL_ROOT_PASSWORD=

# Nome do banco de CATÁLOGO.
MYSQL_DATABASE=portalbase_catalogo

# ----------------------------------------------------------------------------
# (B) RODAR/MIGRAR/TESTAR FORA DO DOCKER (dotnet run / dotnet ef / dotnet test)
#     O `dotnet` NÃO lê o .env sozinho — exporte antes de rodar, por exemplo:
#         set -a; . ./.env; set +a          # (bash/zsh: carrega tudo no shell)
#     ou defina cada `export VAR=...` manualmente.
#     O docker compose IGNORA as variáveis abaixo (usa só as do bloco A).
# ----------------------------------------------------------------------------

# Connection string do banco de CATÁLOGO usada pela aplicação (Web e Worker).
# Formato do provider MySql.EntityFrameworkCore (o `__` vira `:` em ConnectionStrings:Catalogo):
#   server=HOST;port=3306;database=NOME;user=USUARIO;password=SENHA;SslMode=Required
# Em MySQL local de teste SEM TLS, pode usar ...;SslMode=Disabled (NUNCA em produção).
ConnectionStrings__Catalogo=

# Connection strings de DESIGN-TIME (usadas por `dotnet ef ... database update`
# para criar/atualizar o schema). Podem apontar para o mesmo MySQL local.
PORTALBASE_DESIGNTIME_CONNECTION=
PORTALBASE_TENANT_DESIGNTIME_CONNECTION=

# Conexão ADMINISTRATIVA (permissão de CREATE DATABASE/USER/GRANT) que DESTRAVA
# os testes de integração hoje SKIPPED (MySQL/Testcontainers). Sem ela, ficam pulados.
#   ex.: server=localhost;port=3306;user=root;password=SUA_SENHA;SslMode=Disabled
PORTALBASE_TEST_MYSQL_ADMIN=

# ----------------------------------------------------------------------------
# (C) OBSERVABILIDADE (opcional) — vazio DESATIVA a exportação OTLP.
# ----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# ----------------------------------------------------------------------------
# (D) BANCOS POR CONTRIBUINTE (tenant) — referência (appsettings seção "BancoTenant").
#     A SENHA do tenant NUNCA fica aqui: vive no COFRE por REFERÊNCIA
#     (BancoTenant:RuntimeSenhaRef). Aqui só entram host/porta/usuário de runtime,
#     sem segredo. Descomente e ajuste se for rodar o fluxo multi-tenant local.
# ----------------------------------------------------------------------------
# BancoTenant__Servidor=localhost
# BancoTenant__Porta=3306
# BancoTenant__RuntimeUsuario=portalbase_runtime
# BancoTenant__SslMode=Required     # dev sem TLS: Disabled | produção: VerifyCA/VerifyFull
